# Copier en .env puis adapter. Sans .env, docker compose utilise les valeurs par défaut.

# Postgres (service db)
POSTGRES_USER=digest
POSTGRES_PASSWORD=change-me
POSTGRES_DB=digest

# Auth : URL publique de l'app et secret de signature (openssl rand -base64 32)
APP_URL=http://localhost:3000
BETTER_AUTH_SECRET=change-me-with-openssl-rand-base64-32

# Clé maître AES-256-GCM des clés API et webhooks : 32 octets en base64 (openssl rand -base64 32).
# La changer rend illisibles les secrets déjà enregistrés.
ENCRYPTION_KEY=ZGlnZXN0LWRlbW8tYS1yZW1wbGFjZXItZW4tcHJvZCE=

# Emails (vérification, mot de passe oublié). Par défaut : Mailpit, http://localhost:8025
SMTP_URL=smtp://localhost:1025
MAIL_FROM="Digest <digest@localhost>"

# Vérifie les mots de passe contre Have I Been Pwned (requiert un accès sortant)
PASSWORD_BREACH_CHECK=true

# Instance
SIGNUP_ENABLED=true
# Emails des admins de l'instance (page /admin), séparés par des virgules
ADMIN_EMAILS=

# Production (deploy/compose.prod.yaml) : domaine servi par Caddy et version de l'image
# DOMAIN=digest.example.com
# DIGEST_VERSION=latest
# BACKUP_RETENTION_DAYS=14

# Ports exposés sur l'hôte
WEB_PORT=3000
DB_PORT=5432
MAILPIT_PORT=8025
SMTP_PORT=1025

# Développement hors Docker (pnpm dev, pnpm dev:worker, prisma migrate dev)
DATABASE_URL=postgresql://digest:change-me@localhost:5432/digest
