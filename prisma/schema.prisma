// Modèle de données de Digest. Voir docs/cahier-des-charges.md.
// Toutes les données applicatives sont rattachées à un User et supprimées en cascade avec lui.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Frequency {
  daily
  weekly
}

enum DetailLevel {
  short
  standard
  detailed
}

enum DeliveryKind {
  discord
  slack
}

enum RunStatus {
  queued
  running
  succeeded
  failed
}

enum RunTrigger {
  manual
  scheduled
}

enum ItemCategory {
  release
  announcement
  article
  security
  trend
}

enum Feedback {
  useful
  not_useful
}

// User, Session, Account, Verification et RateLimit suivent le schéma attendu par Better Auth.
// Le mot de passe (Argon2id) est stocké dans Account.password, fournisseur « credential ».
model User {
  id            String   @id @default(cuid())
  name          String   @default("")
  email         String   @unique
  emailVerified Boolean  @default(false)
  image         String?
  locale        String   @default("fr")
  timezone      String   @default("Europe/Paris")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  sessions   Session[]
  accounts   Account[]
  apiKey     ApiKey?
  schedule   Schedule?
  topics     Topic[]
  delivery   Delivery?
  runs       Run[]
  digests    Digest[]
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique
  expiresAt DateTime
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Account {
  id                    String    @id @default(cuid())
  userId                String
  accountId             String
  providerId            String
  password              String?
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// Jetons de vérification d'email et de réinitialisation du mot de passe.
model Verification {
  id         String   @id @default(cuid())
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
}

// Compteurs de limite de débit, par IP (Better Auth) et par email.
model RateLimit {
  id          String @id @default(cuid())
  key         String @unique
  count       Int
  lastRequest BigInt
}

// Clé Anthropic chiffrée en AES-256-GCM, jamais renvoyée au navigateur.
model ApiKey {
  id          String    @id @default(cuid())
  userId      String    @unique
  ciphertext  String
  iv          String
  authTag     String
  last4       String
  model       String    @default("claude-sonnet-5")
  validatedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Topic {
  id             String      @id @default(cuid())
  userId         String
  title          String
  description    String      @default("")
  keywords       String[]
  includeDomains String[]
  excludeDomains String[]
  detailLevel    DetailLevel @default(standard)
  active         Boolean     @default(true)
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  user  User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  items Item[]

  @@index([userId])
}

model Schedule {
  id        String    @id @default(cuid())
  userId    String    @unique
  frequency Frequency @default(daily)
  weekday   Int? // 0 = dimanche … 6 = samedi, requis si weekly
  hour      Int       @default(8)
  nextRunAt DateTime?
  paused    Boolean   @default(false)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([nextRunAt])
}

// Webhook Discord ou Slack, URL chiffrée comme la clé API.
model Delivery {
  id            String       @id @default(cuid())
  userId        String       @unique
  kind          DeliveryKind
  hint          String // version masquée de l'URL, seule partie affichée
  urlCiphertext String
  urlIv         String
  urlAuthTag    String
  active        Boolean      @default(true)
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Run {
  id               String     @id @default(cuid())
  userId           String
  trigger          RunTrigger @default(manual)
  status           RunStatus  @default(queued)
  model            String     @default("")
  topicsTotal      Int        @default(0)
  topicsDone       Int        @default(0)
  startedAt        DateTime?
  finishedAt       DateTime?
  inputTokens      Int        @default(0)
  cacheWriteTokens Int        @default(0)
  cacheReadTokens  Int        @default(0)
  outputTokens     Int        @default(0)
  searches         Int        @default(0)
  costUsd          Decimal    @default(0) @db.Decimal(10, 4)
  error            String? // message lisible : échec du run, ou thèmes ignorés
  createdAt        DateTime   @default(now())

  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  digest Digest?

  @@index([userId, createdAt])
}

model Digest {
  id            String    @id @default(cuid())
  runId         String    @unique
  userId        String
  language      String
  deliveredAt   DateTime? // envoi réussi au webhook
  deliveryError String?
  createdAt     DateTime  @default(now())

  run   Run    @relation(fields: [runId], references: [id], onDelete: Cascade)
  user  User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  items Item[]

  @@index([userId, createdAt])
}

model Item {
  id           String       @id @default(cuid())
  digestId     String
  topicId      String?
  title        String
  category     ItemCategory
  summary      String
  whyItMatters String
  relevance    Int // 1 à 5
  urlHash      String // SHA-256 de l'URL normalisée, pour le dédoublonnage
  feedback     Feedback?
  starred      Boolean      @default(false)
  createdAt    DateTime     @default(now())

  digest  Digest   @relation(fields: [digestId], references: [id], onDelete: Cascade)
  topic   Topic?   @relation(fields: [topicId], references: [id], onDelete: SetNull)
  sources Source[]

  @@index([digestId])
  @@index([urlHash])
  // Recherche plein texte : index GIN sur une expression, créé en SQL dans la migration « lecture ».
}

model Source {
  id          String    @id @default(cuid())
  itemId      String
  url         String
  title       String
  domain      String
  publishedAt DateTime?
  citedText   String?

  item Item @relation(fields: [itemId], references: [id], onDelete: Cascade)

  @@index([itemId])
}
